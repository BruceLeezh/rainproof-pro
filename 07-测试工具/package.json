{
  "name": "hanxong-test-tools",
  "private": true,
  "description": "汉客松 07-测试工具 的依赖清单（Node 从文件所在目录向上找 node_modules，所以必须装在这一层或包根）",
  "scripts": {
    "compile": "node compile_sol.js ../03-合约/RainDeliveryInsurance.sol",
    "compile:v2": "node compile_sol.js ../03-合约/RainDeliveryInsuranceV2.sol --via-ir",
    "compile:v3": "node compile_sol.js ../03-合约/RainDeliveryInsuranceV3.sol --via-ir",
    "compile:v5": "node compile_sol.js ../03-合约/RainDeliveryInsuranceV5.sol --via-ir",
    "compile:multisig": "node compile_sol.js ../03-合约/OperatorMultisig.sol",
    "sync-abi": "node sync_abi.js",
    "check-abi": "node sync_abi.js --check",
    "check-page-decode": "node check-page-decode.js",
    "build": "npm run compile && npm run sync-abi",
    "e2e": "node e2e_contract.js",
    "e2e:v2": "node e2e_v2.js",
    "e2e:v3": "node e2e_v3.js",
    "e2e:multisig": "node e2e_multisig.js",
    "check-canonical": "node check-canonical.js",
    "check-ai": "node check-ai.js",
    "check-ui": "node check-ui.js",
    "check-feed-verify": "node check-feed-verify.js",
    "check-pricing-grid": "node check-pricing-grid.js",
    "check-public-repo": "node check-public-repo.js",
    "check-frozen-node": "node check-frozen-node.js",
    "check-verify-pack": "node make-verify-pack.js --check",
    "check-html-syntax": "node check-html-syntax.js",
    "check-cities": "node check-cities.js",
    "check-event-topics": "node check-event-topics.js",
    "check:v3-prices": "node check-v3-prices.js",
    "check-v3-prices:offline": "node check-v3-prices.js --offline",
    "ai:collect": "node ../04-脚本/ai-collect.js",
    "ai:judge": "node ../04-脚本/ai-judge.js",
    "ai:submit": "node ../04-脚本/submit-judgement.js",
    "test": "npm run check-public-repo && npm run check-frozen-node && npm run check-verify-pack && npm run check-canonical && npm run check-ai && npm run check-ui && npm run check-abi && npm run check-page-decode && npm run check-feed-verify && npm run check-pricing-grid && npm run check-v3-prices:offline && npm run check-event-topics && npm run check-rmb-grid && npm run check-v5-bytecode && npm run check-html-syntax && npm run check-cities && npm run check-city-weather && npm run check-cadence && npm run check-pricing-engine && npm run check-review && npm run check-v6 && npm run e2e && npm run e2e:v2 && npm run e2e:multisig && npm run e2e:v3 && npm run e2e:v4 && npm run e2e:v5 && npm run check-replay && npm run e2e:v6-review",
    "e2e:v4": "node e2e_v4_token.js",
    "check-rmb-grid": "node check-rmb-grid.js",
    "check-v5-bytecode": "node check-v5-bytecode.js",
    "check-v5-bytecode:onchain": "node check-v5-bytecode.js --onchain",
    "e2e:v5": "node e2e_v5.js",
    "replay": "node ../04-脚本/replay-judgement.js",
    "check-replay": "node ../04-脚本/replay-judgement.js --all --legacy",
    "check-cadence": "node check-cadence.js",
    "check-cadence:ops": "node check-cadence.js --ops",
    "check-review": "node check-review-regressions.js",
    "e2e:v6-review": "node e2e_v6_review.js || node e2e_v6_review.js",
    "build:site": "node build-site.js",
    "check-pricing-engine": "node ../10-金融与定价/pricing_engine.js --self-check",
    "compile:v6": "node compile_sol.js ../03-合约/RainDeliveryInsuranceV6.sol --via-ir",
    "e2e:v6": "node e2e_v6_review.js || node e2e_v6_review.js",
    "check-v6": "node check-v6-deployment.js",
    "check-v6:onchain": "node check-v6-deployment.js --onchain",
    "check-city-weather": "node check-city-weather.js"
  },
  "dependencies": {
    "ethers": "^6.13.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.26"
  }
