# 用法：把本文件复制成 .env（去掉 .example），再把值填上。
#
# ⚠️ 三条硬规矩：
#   1. 这里的钱包【只用于测试网】，永远不要往里放真钱。
#      一旦放了真钱，这串私钥就等于你的全部身家。
#   2. .env 已在 .gitignore 里，别把它提交到 git，别发给任何人。
#   3. 永远不要把私钥粘到网页、聊天窗口或任何在线工具里。
#
# 变量名以代码里的实际读取为准（2026-11-20 核对）：
#   必需项在「1/2」两组；「3」组不填也能跑，只是少一些功能或断言会被跳过。

########## 1. 链与合约 ##########

# 部署/喂价/keeper/hook 这些脚本统一从这个变量找链。名字是历史包袱（叫 SEPOLIA），
# 值请填【当前目标链】的 RPC。本项目演示链是 BOT Chain 测试网 968：
SEPOLIA_RPC=https://rpc.bohr.life

# 只给 04-脚本/rehearse-v2.js 用（它不读上面的 SEPOLIA_RPC）。
BOT_RPC=https://rpc.bohr.life

# 当前生效的合约版本：V4 / V5 / V6。04-脚本/active-deployment.js 按它选地址。
ACTIVE_CONTRACT_VERSION=V6

# 各版本合约地址。V6 是当前演示链上那一套；V4/V5 只用于历史回放与对照。
CONTRACT_ADDRESS_V6=0x在这里填V6合约地址
CONTRACT_ADDRESS_V5=
CONTRACT_ADDRESS_V4=
# 迁移前那套 V6（只给迁移核验脚本对照用，可留空）
CONTRACT_ADDRESS_V6_PREV=

# 旧脚本的兜底变量：active-deployment 在缺 CONTRACT_ADDRESS_V6 时回落到它。
# 建议与上面 V6 保持一致，避免两处地址漂移。
CONTRACT_ADDRESS=0x在这里填V6合约地址

# RDROP 模拟代币与 2/3 多签
TOKEN_ADDR=0x在这里填RainToken地址
MULTISIG_ADDR=0x在这里填多签地址

########## 2. 密钥（全部测试网） ##########

# 部署/提交/注资用的主钱包私钥
PRIVATE_KEY=0x在这里填你的私钥

# 投保演示用的骑手钱包（rehearse-v2 --use-env-rider、multisig-ops、replay_chain 会读）
RIDER_KEY=0x在这里填骑手私钥

# 三个 owner 的私钥文件（JSON）。相对路径以 04-脚本 为基准；
# 本仓库约定放在仓库根的 雨证密钥/，仓库外还留了一个 ../密钥-本地 兼容软链。
OWNER_KEY_FILE=../雨证密钥/owner-keys-2026-10-24.json

# 演示钱包（买保单/发币脚本用）
DEMO_WALLET_FILE=../雨证密钥/demo-wallet-2026-11-03.json

########## 3. 可选：运维开关与外部集成 ##########

# keeper 专用钥匙（可选）：不填则退回 PRIVATE_KEY。领赔款不需要权限。
KEEPER_KEY=

# 喂价主路被封时的手动开关：=1 强制走边缘 IP（04-脚本/push-rainfall-v6.js）
FEED_FORCE_EDGE=0

# 降雨 epoch（只影响 04-脚本/regions.js 的默认窗口；改它等于改取数口径，别随手动）
RAIN_EPOCH=2026-10-01

# 判定留痕输出目录（默认 09-AI判定留痕/ 或 …/v6/<合约>）
AI_OUT_DIR=

# 企业微信机器人（ops-daily 推送用，不填则不发）
WECOM_WEBHOOK=

# 某些脚本要用 git 命令时的可执行文件路径（Windows 上留空即可）
GIT_EXE=

# 代理/RPC 上游（本机网络异常时的排查开关）
RPC_UPSTREAM=
NODE_USE_ENV_PROXY=

# v2 彩排的版本指纹断言（不填 → 该断言 SKIP，不算通过数）
V2_OPERATOR=
V2_ADDRESS=
V2_RPC=

# 定价 V3 合约（10-金融与定价/ref/PricingV3.sol 部署产物）——
# 04-脚本/deploy-pricing-v3.js 在不给 --rpc/--addr 时读这两个；
# 07-测试工具/check-v3-prices.js 读 V3_SPEC_JSON。
PRICING_V3_RPC=https://rpc.bohr.life
PRICING_V3_ADDR=
V3_SPEC_JSON=

# 只在做 AI 判定实验/对比模型时用（日常门禁不需要）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MODEL_VERSION=
OPENAI_API_KEY=
